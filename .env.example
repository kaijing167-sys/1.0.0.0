# 默认无需配置，使用项目目录中的 SQLite game.db。
# PostgreSQL 示例：
# DATABASE_URL=postgresql+asyncpg://user:password@127.0.0.1:5432/high_school_simulator
DATABASE_URL=sqlite+aiosqlite:///./game.db
REDIS_URL=redis://127.0.0.1:6379/0

# 游戏后台调用 Ollama 时使用；不要把这个地址暴露给浏览器。
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_TIMEOUT_SECONDS=90
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=40
CHAT_HISTORY_CHARS=300
OLLAMA_WARMUP_ON_STARTUP=0
NPC_PROMPT_MODE=full
NPC_RUNTIME_DIR=./personas
